# ========================================
# 全能创意大师 - 生产环境Dockerfile
# 多阶段构建：前端构建 + 后端运行
# 优化：分层安装依赖，提高缓存利用率
# 优化：静默模式安装，减少日志刷屏
# ========================================

# ==================== 阶段1：前端构建 ====================
FROM node:20-alpine AS frontend-builder

WORKDIR /app/frontend

# 复制前端依赖文件
COPY frontend/package*.json ./

# 安装依赖（使用阿里云npm镜像加速，静默模式）
RUN npm config set registry https://registry.npmmirror.com && \
    npm ci --loglevel=error

# 复制前端源码
COPY frontend/ ./

# 构建前端（静默模式）
RUN npm run build --silent 2>/dev/null || npm run build

# ==================== 阶段2：后端运行 ====================
FROM python:3.10-slim

# 设置工作目录
WORKDIR /app

# 设置环境变量（禁用进度条加速构建）
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_PROGRESS_BAR=off \
    PIP_QUIET=1

# 使用阿里云镜像源
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list 2>/dev/null || true

# 安装系统依赖（静默模式）
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    libpq5 \
    curl \
    build-essential \
    libpq-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 创建虚拟环境
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 配置pip使用阿里云镜像源
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip config set global.trusted-host "mirrors.aliyun.com pypi.org files.pythonhosted.org"

# 升级pip（静默模式）
RUN pip install --upgrade pip setuptools wheel --quiet

# ===== 分层安装Python依赖（提高缓存利用率）=====
# 每层使用静默模式安装，只在开始和结束时输出日志

# 第1层：核心框架（变化少，缓存命中率高）
COPY backend/requirements.txt ./
RUN echo "[PIP] 安装核心框架..." && \
    pip install --progress-bar=off --quiet \
    fastapi uvicorn[standard] python-multipart pydantic pydantic-settings email-validator \
    sqlalchemy[asyncio] aiosqlite asyncpg psycopg2-binary alembic redis && \
    echo "[PIP] 核心框架安装完成"

# 第2层：HTTP客户端和工具（中等变化频率）
RUN echo "[PIP] 安装HTTP客户端和工具..." && \
    pip install --progress-bar=off --quiet \
    requests urllib3 httpx aiohttp aiofiles \
    python-dotenv beautifulsoup4 lxml readability-lxml \
    numpy pyyaml loguru pypdf python-docx json-repair && \
    echo "[PIP] HTTP客户端和工具安装完成"

# 第3层：认证和安全（稳定）
RUN echo "[PIP] 安装认证和安全模块..." && \
    pip install --progress-bar=off --quiet \
    python-jose[cryptography] PyJWT passlib[bcrypt] bcrypt==4.0.1 && \
    echo "[PIP] 认证和安全模块安装完成"

# 第4层：LLM API客户端（经常更新）
RUN echo "[PIP] 安装LLM API客户端..." && \
    pip install --progress-bar=off --quiet \
    openai dashscope google-genai \
    langchain langchain-community langchain-openai langchain-google-genai && \
    echo "[PIP] LLM API客户端安装完成"

# 第5层：重型依赖（向量数据库，安装最慢，放最后）
RUN echo "[PIP] 安装向量数据库和模型（这可能需要几分钟）..." && \
    pip install --progress-bar=off --quiet \
    networkx pysqlite3-binary chromadb sentence-transformers && \
    echo "[PIP] 向量数据库和模型安装完成"

# 第6层：测试依赖（可选）
RUN echo "[PIP] 安装测试依赖..." && \
    pip install --progress-bar=off --quiet pytest pytest-asyncio && \
    echo "[PIP] 测试依赖安装完成"

# 复制后端应用代码
COPY backend/ ./

# 从前端构建阶段复制构建产物
COPY --from=frontend-builder /app/backend/app/static ./app/static

# 创建必要的目录
RUN mkdir -p /app/logs /app/data/chroma /app/data/uploads /app/data/knowledge_graphs

# 移除敏感文件
RUN rm -rf /app/.git /app/.env /app/.env.local 2>/dev/null || true

# 创建非root用户
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动命令
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
