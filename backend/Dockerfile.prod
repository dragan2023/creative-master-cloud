# ========================================
# 全能创意大师 - 生产环境Dockerfile
# 针对阿里云服务器优化版本
# ========================================

# ==================== 阶段1：前端构建 ====================
FROM node:20-alpine AS frontend-builder

WORKDIR /app/frontend

# 使用阿里云npm镜像（阿里云服务器最优选择）
COPY frontend/package*.json ./
RUN npm config set registry https://registry.npmmirror.com && \
    npm ci --loglevel=error

COPY frontend/ ./
RUN npm run build

# ==================== 阶段2：后端运行 ====================
FROM python:3.10-slim

WORKDIR /app

# 环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# ===== 关键优化：使用阿里云镜像源 =====
# 阿里云官方镜像站：https://mirrors.aliyun.com
# 针对阿里云ECS服务器最优配置
RUN set -ex && \
    echo "==> 配置阿里云APT镜像源..." && \
    # Debian 11 (bullseye) 配置
    echo "deb https://mirrors.aliyun.com/debian/ bullseye main contrib non-free" > /etc/apt/sources.list && \
    echo "deb https://mirrors.aliyun.com/debian/ bullseye-updates main contrib non-free" >> /etc/apt/sources.list && \
    echo "deb https://mirrors.aliyun.com/debian-security bullseye-security main contrib non-free" >> /etc/apt/sources.list && \
    echo "==> APT镜像源配置完成"

# 更新软件源
RUN echo "==> 更新软件源..." && \
    apt-get update && \
    echo "==> 软件源更新完成"

# 分步安装系统依赖（阿里云镜像站，速度很快）
RUN echo "==> 安装curl和基础工具..." && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    echo "==> curl安装完成"

RUN echo "==> 安装PostgreSQL客户端库..." && \
    apt-get install -y --no-install-recommends libpq5 libpq-dev && \
    echo "==> PostgreSQL库安装完成"

RUN echo "==> 安装编译工具链（约1-2分钟）..." && \
    apt-get install -y --no-install-recommends build-essential python3-dev && \
    echo "==> 编译工具链安装完成"

# 清理apt缓存
RUN apt-get clean && rm -rf /var/lib/apt/lists/* && \
    echo "==> 系统依赖全部安装完成"

# 创建虚拟环境
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 使用阿里云PyPI镜像
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip config set global.trusted-host "mirrors.aliyun.com"

# 升级pip
RUN pip install --upgrade pip setuptools wheel

# ===== 分层安装Python依赖 =====
COPY backend/requirements.txt ./

# 第1层：核心框架
RUN echo "==> 安装核心框架..." && \
    pip install --progress-bar=off \
    fastapi uvicorn[standard] python-multipart pydantic pydantic-settings email-validator \
    sqlalchemy[asyncio] aiosqlite asyncpg psycopg2-binary alembic redis && \
    echo "==> 核心框架安装完成"

# 第2层：HTTP客户端和工具
RUN echo "==> 安装HTTP客户端和工具..." && \
    pip install --progress-bar=off \
    requests urllib3 httpx aiohttp aiofiles \
    python-dotenv beautifulsoup4 lxml readability-lxml \
    numpy pyyaml loguru pypdf python-docx json-repair && \
    echo "==> HTTP客户端和工具安装完成"

# 第3层：认证和安全
RUN echo "==> 安装认证和安全模块..." && \
    pip install --progress-bar=off \
    python-jose[cryptography] PyJWT passlib[bcrypt] bcrypt==4.0.1 && \
    echo "==> 认证和安全模块安装完成"

# 第4层：LLM API客户端
RUN echo "==> 安装LLM API客户端..." && \
    pip install --progress-bar=off \
    openai dashscope google-genai \
    langchain langchain-community langchain-openai langchain-google-genai && \
    echo "==> LLM API客户端安装完成"

# 第5层：重型依赖（向量数据库，最慢）
RUN echo "==> 安装向量数据库和模型（约5-10分钟）..." && \
    pip install --progress-bar=off \
    networkx pysqlite3-binary chromadb sentence-transformers && \
    echo "==> 向量数据库和模型安装完成"

# 第6层：测试依赖
RUN echo "==> 安装测试依赖..." && \
    pip install --progress-bar=off pytest pytest-asyncio && \
    echo "==> 测试依赖安装完成"

# 复制后端应用代码
COPY backend/ ./

# 复制版本文件（用于版本号动态获取）
COPY version.json /app/version.json

# 从前端构建阶段复制构建产物
COPY --from=frontend-builder /app/backend/app/static ./app/static

# 创建必要的目录
RUN mkdir -p /app/logs /app/data/chroma /app/data/uploads /app/data/knowledge_graphs /app/data/character_states /app/data/novel_projects /app/data/exports /app/data/backups

# 移除敏感文件
RUN rm -rf /app/.git /app/.env /app/.env.local 2>/dev/null || true

# 创建非root用户
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
