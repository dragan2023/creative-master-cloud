# ========================================
# 全能创意大师 - 生产环境Dockerfile
# 多阶段构建：前端构建 + 后端运行
# ========================================

# ==================== 阶段1：前端构建 ====================
FROM node:20-alpine AS frontend-builder

WORKDIR /app/frontend

# 复制前端依赖文件
COPY frontend/package*.json ./

# 安装依赖（使用阿里云npm镜像加速）
# 注意：需要安装所有依赖（包括devDependencies），因为vite是开发依赖
RUN npm config set registry https://registry.npmmirror.com && \
    npm ci

# 复制前端源码
COPY frontend/ ./

# 构建前端（输出到 backend/app/static）
RUN npm run build

# ==================== 阶段2：后端运行 ====================
FROM python:3.10-slim

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 使用阿里云镜像源（包括安全更新源）
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list 2>/dev/null || true && \
    sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's/security.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list 2>/dev/null || true

# 安装系统依赖（运行时必需 + 编译依赖）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    build-essential \
    libpq-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 创建虚拟环境
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 复制依赖文件（从 backend 目录）
COPY backend/requirements.txt .

# 安装Python依赖（多镜像源重试机制）
RUN pip install --upgrade pip && \
    pip install --no-cache-dir \
    --trusted-host pypi.tuna.tsinghua.edu.cn \
    --trusted-host mirrors.aliyun.com \
    --trusted-host pypi.org \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    -r requirements.txt || \
    pip install --no-cache-dir \
    --trusted-host mirrors.aliyun.com \
    --trusted-host pypi.org \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    -r requirements.txt || \
    pip install --no-cache-dir \
    --trusted-host pypi.org \
    --trusted-host files.pythonhosted.org \
    -r requirements.txt

# 复制后端应用代码
COPY backend/ .

# 从前端构建阶段复制构建产物
COPY --from=frontend-builder /app/backend/app/static ./app/static

# 创建必要的目录
RUN mkdir -p /app/logs /app/data/chroma /app/data/uploads /app/data/knowledge_graphs

# 移除敏感文件（如果有）
RUN rm -rf /app/.git /app/.env /app/.env.local 2>/dev/null || true

# 创建非root用户
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动命令（多worker模式）
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
