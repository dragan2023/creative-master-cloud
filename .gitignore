# ========================================
# 全能创意大师 - Git忽略配置
# 区分本地开发环境和云端生产环境
# ========================================

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/
build_venv/

# ===== 环境变量（敏感信息）=====
# 本地开发环境配置（不提交）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env.local
frontend/.env.development

# 云端部署配置模板（可提交）
!.env.example
!.env.cloud

# ===== 日志文件（不提交）=====
logs/
*.log
*.log.zip
backend/logs/
nginx/logs/

# ===== 数据库文件（不提交）=====
*.db
*.sqlite3
*.db-journal
backend/*.db
backend/novel_writer.db
backend/data/*.db

# ===== Node.js =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json

# ===== 前端构建缓存 =====
frontend/dist/
frontend/.vite/


# ===== 构建产物 =====
# 发行版构建产物（不提交，通过CI/CD生成）
dist/
build/
*.egg-info/
*.egg

# 后端静态文件（由前端构建生成）
backend/app/static/assets/
backend/app/static/index.html
!backend/app/static/.gitkeep

# ===== Docker相关 =====
# Docker数据卷映射目录
backenddata/
# 本地Docker配置（不提交）
docker-daemon.json

# ===== 本地开发临时文件 =====
*.local
*.tmp
*.temp
*.bak
*.cache
*.swp
*.swo

# ===== IDE和编辑器 =====
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ===== 大模型文件（太大不上传）=====
*.bin
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.pickle
marker_models/
chonkie_models/
backend/data/marker_models/

# ===== 向量数据库和知识图谱 =====
backend/data/chroma/
backend/data/knowledge_graphs/
backend/data/exports/
backend/data/novel_projects/
backend/data/uploads/
backend/data/backups/

# ===== 编译后的二进制文件 =====
*.pyd
*.pyi
backend/*.pyd
backend/*.pyi

# ===== PyArmor相关 =====
pyarmor.bug.log
.pyarmor/
backend/pyarmor.bug.log

# ===== 敏感信息 =====
*.pem
*.key
*.crt
secrets/
nginx/ssl/*.crt
nginx/ssl/*.key
!nginx/ssl/.gitkeep

# ===== 操作系统 =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== 测试 =====
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ===== Qoder配置 =====
.qoder/

# ===== 备份和打包文件 =====
*.backup
*.rar
*.zip
*.7z
pack-exclude.txt

# ===== 保留云端部署必需文件 =====
!scripts/deploy.sh
!scripts/download-model.sh
!scripts/deploy-cloud.sh
!docker-compose.prod.yml
!docker-compose.cloud.yml
!nginx/nginx.conf
!nginx/ssl-setup.sh
