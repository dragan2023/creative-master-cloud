# ========================================
# 全能创意大师 - Git忽略配置（云端部署版）
# ========================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/
build_venv/

# ----- 环境变量（敏感信息）-----
.env
.env.local
.env.production
.env.development
backend/.env
frontend/.env.local

# ----- 日志文件 -----
logs/
*.log
backend/logs/

# ----- 数据库文件 -----
*.db
*.sqlite3
backend/*.db
backend/novel_writer.db

# ----- Node.js -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----- IDE配置 -----
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ----- 操作系统 -----
.DS_Store
Thumbs.db
Desktop.ini

# ----- 测试 -----
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ----- 构建产物 -----
dist/
build/
*.egg-info/
*.egg

# 前端构建产物（保留index.html等源文件）
frontend/dist/

# ----- 本地开发 -----
*.local

# ----- 大模型文件（太大不上传）-----
*.bin
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.pickle
marker_models/
chonkie_models/

# ----- 数据目录（用户生成的内容）-----
backend/data/
backend/app/data/
backenddata/

# ----- 编译后的二进制文件 -----
*.pyd
backend/*.pyd
backend/*.pyi

# ----- PyArmor相关 -----
pyarmor.bug.log
.pyarmor/

# ----- 敏感信息 -----
*.pem
*.key
secrets/

# ----- 临时文件 -----
*.tmp
*.temp
*.bak
*.cache

# ----- Qoder配置 -----
.qoder/

# ----- 云端部署脚本（保留）-----
!scripts/deploy.sh
!scripts/download-model.sh

# ----- 备份文件 -----
*.backup

# ----- 打包相关 -----
pack-exclude.txt

# ----- 发行版（不推送构建产物）-----
dist/

# ----- 其他 -----
*.rar
*.zip
