# ========================================
# 全能创意大师 - Git忽略配置
# 开发环境：非容器化本地开发（run-local.bat）
# 生产环境：容器化云端部署（docker-compose.prod.yml / cloud.yml）
# ========================================

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/
build_venv/
*.pyd
*.pyi
*.egg-info/
*.egg

# ===== Node.js =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== 前端构建 =====
frontend/dist/
frontend/.vite/

# ===== 后端数据 =====
backend/data/chroma/
backend/data/knowledge_graphs/
backend/data/exports/
backend/data/novel_projects/
backend/data/uploads/
backend/data/backups/
backend/data/marker_models/
*.db
*.sqlite3
*.db-journal
backend/*.db

# ===== 环境变量 =====
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env.local
frontend/.env.development
!.env.example
!.env.cloud

# ===== 日志文件 =====
logs/
*.log
*.log.zip
backend/logs/
nginx/logs/
install.log

# ===== Docker =====
backenddata/
docker-daemon.json

# ===== IDE和编辑器 =====
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.qoder/

# ===== 大模型文件 =====
*.bin
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.pickle
marker_models/
chonkie_models/

# ===== 敏感信息 =====
*.pem
*.key
*.crt
secrets/
nginx/ssl/*.crt
nginx/ssl/*.key
!nginx/ssl/.gitkeep

# ===== 操作系统 =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== 构建产物 =====
dist/
build/
backend/app/static/assets/
backend/app/static/index.html
!backend/app/static/.gitkeep

# ===== 测试 =====
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ===== 工作文档 =====
docs/

# ===== 备份和打包文件 =====
*.backup
*.bak
*.rar
*.zip
*.7z
*.tar
*.tmp
*.temp
*.cache
pack-exclude.txt

# ===== 保留云端部署必需文件 =====
!scripts/deploy.sh
!scripts/download-model.sh
!scripts/deploy-cloud.sh
!docker-compose.prod.yml
!docker-compose.cloud.yml
!nginx/nginx.conf
!nginx/ssl-setup.sh
