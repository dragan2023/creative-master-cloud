# ========================================
# 全能创意大师 - 云端生产环境配置模板
# 用法：复制本文件为 .env.cloud 并填写真实值；.env.cloud 不纳入 Git。
# 严禁将真实密钥、口令、令牌提交到仓库。
# ========================================

# ==================== 应用配置 ====================
APP_NAME=全能创意大师
# 产品版本以根目录 version.json.current_version 为唯一来源，此处即使填写也会被忽略
# APP_VERSION=（由 version.json 提供，无需在 .env 维护）
DEBUG=False

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库配置（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://creative_user:CHANGE_ME_DB_PASSWORD@db:5432/creative_master
DB_USER=creative_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=creative_master

# Redis配置
REDIS_URL=redis://redis:6379/0

# JWT密钥（生产环境必须修改！）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=/app/logs

# 向量数据库
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_MODEL_CACHE_DIR=/app/data/chroma/models

# 知识图谱
KNOWLEDGE_GRAPH_DIR=/app/data/knowledge_graphs

# 文件上传配置
MAX_UPLOAD_SIZE=209715200
UPLOAD_DIR=/app/data/uploads

# CORS配置
CORS_ORIGINS=*

# 多租户配置
MULTI_TENANT_ENABLED=True

# LLM API Keys（通过管理界面配置，此处留空）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=

# 代理配置（可选）
HTTP_PROXY=
HTTPS_PROXY=

# HuggingFace镜像（国内加速）
HF_ENDPOINT=https://hf-mirror.com

# ==================== 国内镜像源配置 ====================
# PyPI镜像源（Python依赖下载加速）
# 清华源: https://pypi.tuna.tsinghua.edu.cn/simple
# 阿里源: https://mirrors.aliyun.com/pypi/simple/
PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple

# npm镜像源（Node.js依赖下载加速）
# 淘宝源: https://registry.npmmirror.com
# 官方源: https://registry.npmjs.org
NPM_MIRROR=https://registry.npmmirror.com

# Docker商像加速器（可选，需在Docker配置中设置）
# 阿里云: https://[你的ID].mirror.aliyuncs.com
# 网易: https://hub-mirror.c.163.com
# 中科大: https://docker.mirrors.ustc.edu.cn

# ==================== 超级管理员账号配置 ====================
# 用于创建系统超级管理员账号（首次启动时自动创建）
# 注意：请在生产环境中修改这些值！
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.com
