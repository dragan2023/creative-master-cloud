# 前端环境变量配置
# 复制此文件为 .env.local (本地开发) 或 .env.production (生产环境)

# API 基础 URL
# 开发环境：留空，使用 Vite 代理（推荐）
# 生产环境：设置为后端服务的完整 URL，如 http://your-server:8000
# 异地运行时，必须配置此后端地址
VITE_API_BASE_URL=

# 后端服务地址（用于 Vite 开发代理）
# 仅在开发环境需要配置
# 生产环境/异地运行时，此配置无效，请使用 VITE_API_BASE_URL
VITE_BACKEND_URL=http://localhost:8000

# 前端服务端口
VITE_FRONTEND_PORT=5173
