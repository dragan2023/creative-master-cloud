# 应用配置
APP_NAME=全能创意大师
APP_VERSION=1.0.0
APP_BASE_URL=http://localhost:5173
DEBUG=True

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库配置 - 使用SQLite（默认，无需额外配置）
DATABASE_URL=sqlite+aiosqlite:///./data/creative_master.db

# Redis配置（可选，暂时禁用）
REDIS_URL=redis://localhost:6379/0

# JWT密钥（生产环境请修改）
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs

# 向量数据库
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_MODEL_CACHE_DIR=./data/chroma/models

# 知识图谱
KNOWLEDGE_GRAPH_DIR=./data/knowledge_graphs

# 文档预处理配置
DOC_PREPROCESSOR_ENABLED=True
MARKER_ENABLED=True
SEMANTIC_CHUNK_ENABLED=True
SEMANTIC_CHUNK_SIZE=1024
SEMANTIC_THRESHOLD=0.7
SUMMARIZATION_ENABLED=False
MARKER_MODEL_DIR=./data/marker_models

# GPU配置
USE_GPU=True
GPU_DEVICE_ID=0
FORCE_GPU=True

# 文件上传配置
MAX_UPLOAD_SIZE=209715200
UPLOAD_DIR=./data/uploads
MAX_IMAGE_SIZE=52428800
MAX_DOC_SIZE=52428800

# CORS配置（* 表示允许所有源，生产环境建议配置具体域名，多个用逗号分隔）
CORS_ORIGINS=*

# 知识库配置
TEMP_KNOWLEDGE_EXPIRE_HOURS=24

# 版本管理配置
MAX_VERSION_HISTORY=5

# LLM API Keys（可选，通过管理界面配置优先）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=

# Hugging Face 镜像配置（国内加速，可选）
# 国内用户推荐设置: https://hf-mirror.com
HF_ENDPOINT=

# 代理配置（用于下载依赖和访问国外服务，可选）
# 格式: http://代理地址:端口
HTTP_PROXY=
HTTPS_PROXY=

# ============ 镜像源配置（可选）============
# 以下配置用于加速依赖下载，国内用户建议配置
# PyPI 镜像源（留空使用默认检测）:
#   清华: https://pypi.tuna.tsinghua.edu.cn/simple
#   阿里: https://mirrors.aliyun.com/pypi/simple/
#   豆瓣: https://pypi.doubanio.com/simple/
# npm 商像源（留空使用默认检测）：
#   淘宝: https://registry.npmmirror.com
#   官方: https://registry.npmjs.org

# ============ 超级管理员账号配置 ============
# 用于创建系统超级管理员账号（首次启动时自动创建）
# 注意：请在生产环境中修改这些值！
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password-here
# ADMIN_EMAIL=admin@example.com
